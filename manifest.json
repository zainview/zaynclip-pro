{
  "manifest_version": 3,
  "name": "Clipboard Pro — Manager & Text Expander",
  "version": "2.0",
  "description": "Unlimited clipboard history, text expander, widget, sync & lock. 100% aapke control mein.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clipboard Pro (Alt+Shift+V)"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Open clipboard popup"
    },
    "toggleWidget": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle on-page clipboard widget"
    },
    "paste-fav-1": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "Paste pinned clip #1"
    },
    "paste-fav-2": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Paste pinned clip #2"
    },
    "paste-fav-3": { "description": "Paste pinned clip #3" },
    "paste-fav-4": { "description": "Paste pinned clip #4" },
    "paste-fav-5": { "description": "Paste pinned clip #5" },
    "floatingMode": { "description": "Open floating mode window" },
    "lockNow": { "description": "Lock clipboard now" }
  }
}
